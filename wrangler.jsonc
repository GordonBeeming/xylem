{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xylem-preview",
  "account_id": "27d8c1d79794dc980082545da44808c2",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_TINA_CLIENT_ID": "8e8eb6ca-0176-48be-9461-808cf0022d7b",
    "XYLEM_PREVIEW": "1"
  }
}
